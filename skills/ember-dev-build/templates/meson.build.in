# meson.build - the @BOARD@ emulation: builds build/@BOARD@-run from the sources listed in
# emulation/meson.build against ember, the project's subproject (subprojects/ember.wrap
# pins the revision; scripts/build-ember.sh puts that revision plus patches/ in
# subprojects/ember).
#
#   scripts/build-ember.sh       full build (first time, after a pin or patch change)
#   scripts/rebuild.sh           after editing emulation/ (checks, then meson compile -C build)
#   meson test -C build          the checks in tests/

project('@BOARD@', 'c',
  version: '0.1',
  meson_version: '>= 1.1',
  default_options: [
    'c_std=c11',
    'warning_level=2',
    'werror=true',
    'buildtype=debugoptimized',
    # Always the pinned ember of subprojects/, never one the system happens to have.
    'wrap_mode=forcefallback',
  ],
)

board = '@BOARD@'

add_project_arguments('-D_DEFAULT_SOURCE',
  meson.get_compiler('c').get_supported_arguments('-Wshadow', '-Wstrict-prototypes', '-Wmissing-prototypes'),
  language: 'c')

# ember: its public headers and libuam.a (with libm, which ember's floating-point models
# use), built with this project's options.
uam_dep = dependency('uam')

subdir('emulation')   # sets board_sources

runner = executable(board + '-run', board_sources,
  include_directories: include_directories('emulation'),
  dependencies: uam_dep)

subdir('tests')
